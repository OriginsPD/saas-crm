# Portfolio SaaS CRM local environment
# Copy to .env or app-specific env files as needed. Never commit real .env files.

# PostgreSQL from packages/db/docker-compose.yml
DATABASE_URL=postgres://postgres:password@localhost:5432/portfolio-saas-crm

# Better Auth
# Generate a local value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-character-local-secret
BETTER_AUTH_URL=http://localhost:3000

# Web app origin allowed by Elysia CORS
CORS_ORIGIN=http://localhost:3001

# Web client API base URL
VITE_SERVER_URL=http://localhost:3000

# development | test | production
NODE_ENV=development
