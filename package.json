{
	"name": "portfolio-saas-crm",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6",
			"@types/bun": "^1.3.14",
			"better-auth": "1.6.23",
			"evlog": "^2.19.2",
			"lucide-react": "^1.23.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.7",
			"react-dom": "^19.2.7",
			"sonner": "^2.0.7",
			"tailwindcss": "^4.3.2",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"check-types": "bun run --filter '*' check-types",
		"typecheck": "bun run check-types",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"test": "bun run test:unit && bun run test:integration && bun run test:e2e",
		"test:unit": "bun run --filter @portfolio-saas-crm/db test:unit && bun run --filter @portfolio-saas-crm/auth test:unit",
		"test:integration": "bun run --filter @portfolio-saas-crm/db test:integration && bun run --filter server test:integration",
		"test:e2e": "bun run --filter web test:e2e",
		"quality:all": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
		"dev:web": "bun run --filter web dev",
		"dev:server": "bun run --filter server dev",
		"db:push": "bun run --filter @portfolio-saas-crm/db db:push",
		"db:studio": "bun run --filter @portfolio-saas-crm/db db:studio",
		"db:generate": "bun run --filter @portfolio-saas-crm/db db:generate",
		"db:migrate": "bun run --filter @portfolio-saas-crm/db db:migrate",
		"db:start": "bun run --filter @portfolio-saas-crm/db db:start",
		"db:watch": "bun run --filter @portfolio-saas-crm/db db:watch",
		"db:stop": "bun run --filter @portfolio-saas-crm/db db:stop",
		"db:down": "bun run --filter @portfolio-saas-crm/db db:down",
		"db:seed": "bun run --filter @portfolio-saas-crm/db db:seed",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@portfolio-saas-crm/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@portfolio-saas-crm/config": "workspace:*",
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
