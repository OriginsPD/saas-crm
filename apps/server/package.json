{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"test:integration": "bun test ./src/tests/integration/**/*.test.ts",
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@portfolio-saas-crm/auth": "workspace:*",
		"@portfolio-saas-crm/db": "workspace:*",
		"@portfolio-saas-crm/env": "workspace:*",
		"@sinclair/typebox": "^0.34.49",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"elysia": "^1.4.29",
		"evlog": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@portfolio-saas-crm/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.22.3",
		"typescript": "catalog:"
	}
}
